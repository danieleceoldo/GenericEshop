@page "/orders"
@inject OrderDb OrderDb

<h2>Orders</h2>

@if (OrderDb.Data.Any())
{
    <ul>
        @foreach (var order in OrderDb.Data)
        {
            <li>
                <h3>Order @order.GetHashCode()</h3>
                <ul>
                    @foreach (var item in order.Items)
                    {
                        <li>@item.Product?.Name - @item.Product?.Price.ToString("C") - @item.Quantity - @item.TotalPrice.ToString("C")</li>
                    }
                </ul>
                <p><strong>Order Total: @order.TotalPrice.ToString("C")</strong></p>
            </li>
        }
    </ul>
}
else
{
    <p>No orders have been placed yet.</p>
}