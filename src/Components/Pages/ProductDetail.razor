@page "/products/{Id}"
@rendermode InteractiveServer
@inject ProductDb ProductDb
@inject Cart Cart

<h2>Product Detail</h2>

@if (product == null)
{
    <p>Product not found.</p>
}
else
{
    <div>
        <p><strong>@product.Name</strong></p>
        <p>@product.Description</p>
        <p>Price: @product.Price</p>
        <img src="@product.ImageUrl" alt="@product.Name"/>
    </div>
    <div>
        <button @onclick="() => quantity = Math.Max(1, quantity - 1)">-</button>
        <span>@quantity</span>
        <button @onclick="() => quantity = Math.Min(4, quantity + 1)">+</button>
    </div>
    <div>
        <button @onclick="() => Cart.AddItem(product, quantity)">Add to Cart</button>
    </div>
    @if (Cart.Items.Any(item => item.Product == product))
    {
            <p>Number of item(s) of this product in the cart: @Cart.Items.First(item => item.Product == product).Quantity item(s) .</p>
    }
}

<nav>
    <NavLink href="/cart">Go to Cart</NavLink>
    <NavLink href="/products">Back to Products</NavLink>
</nav>

@code {
    [Parameter]
    public string? Id { get; set; }

    Product? product;
    uint quantity = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            product = ProductDb.Data.FirstOrDefault(p => p.Id == Id);
        }
    }
}
