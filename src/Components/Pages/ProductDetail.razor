@page "/products/{Id}"
@rendermode InteractiveServer
@inject ProductDb ProductDb
@inject GenericEshop.Models.Cart Cart_

<h2>Product Detail</h2>

@if (product == null)
{
    <p>Product not found.</p>
}
else
{
    <div>
        <p><strong>@product.Name</strong></p>
        <p>@product.Description</p>
        <p>Price: @product.Price</p>
        <img src="@product.ImageUrl" alt="@product.Name"/>
    </div>
    <div>
        <button @onclick="() => Cart_.products.Add(product)">Add to Cart</button>
    </div>
    <div>
        @if (Cart_.products.Contains(product))
        {
            <p>Product is in the cart.</p>
        }
    </div>
}
<div>
    <NavLink href="/products">Back to Products</NavLink>
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    Product? product;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            product = ProductDb.Data.FirstOrDefault(p => p.Id == Id);
        }
    }
}
